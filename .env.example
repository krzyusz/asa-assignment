# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. In production these come from a secrets manager, not a file.

# JWT signing key for the API. REQUIRED. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Base URL baked into generated "share report" links. Set to the hostname
# stakeholders use to reach the API. If you override API_PORT below, match it here.
# PUBLIC_BASE_URL=http://localhost:8000

# Host ports for `docker compose` (change if 8000 / 3001 are taken locally):
# API_PORT=8000
# NOTIFY_PORT=3001

# Optional overrides (sane defaults exist in docker-compose.yml):
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# NOTIFY_SERVICE_URL=http://notify:3001
# DATABASE_URL=sqlite:////data/vulntracker.db
